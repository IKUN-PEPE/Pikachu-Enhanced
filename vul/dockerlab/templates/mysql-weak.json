{
  "id": "mysql-weak",
  "name": "MySQL 弱口令",
  "category": "database",
  "image": "mysql:8.0",
  "container_name": "pikachu-mysql-weak",
  "labels": {
    "pikachu.lab": "true",
    "pikachu.template": "mysql-weak"
  },
  "ports": [
    {
      "host_ip": "127.0.0.1",
      "host_port": 13306,
      "container_port": 3306,
      "protocol": "tcp"
    }
  ],
  "env": [
    "MYSQL_ROOT_PASSWORD=root",
    "MYSQL_DATABASE=pikachu_lab"
  ],
  "cmd": [],
  "entry_url": "http://127.0.0.1:8765/vul/sqli/sqli_iu/sqli_login.php",
  "notes": "演示 MySQL 数据库弱口令爆破与 UDF 动态链接库提权场景，本地端口 13306 隔离防护。",
  "enabled": true
}
