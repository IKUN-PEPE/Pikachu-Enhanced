{
    "name": "pikachu-enhanced/cyber-range",
    "description": "Modernized Multi-Vector Cybersecurity Range & Vulnerability Testbed",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Pikachu Enhanced Team",
            "homepage": "https://github.com/IKUN-PEPE/Pikachu-Enhanced"
        }
    ],
    "require": {
        "php": ">=7.4 || >=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Pikachu\\": "src/"
        },
        "files": [
            "inc/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pikachu\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "phpcs": "phpcs --standard=PSR12 src/ tests/",
        "phpcs-fix": "phpcbf --standard=PSR12 src/ tests/",
        "phpstan": "phpstan analyse --level=5 src/",
        "lint": [
            "@phpcs",
            "@phpstan"
        ],
        "check": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {}
    }
}
