<?xml version="1.0"?>
<ruleset name="Pikachu-Enhanced-PSR12">
    <description>PSR-12 Coding Style Standard for Pikachu-Enhanced Core & Tests</description>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg value="p"/>

    <!-- Check modern application layers -->
    <file>src/</file>
    <file>tests/</file>
    <file>inc/bootstrap.php</file>

    <!-- Exclude intentional vulnerability payloads & legacy files from strict style checks -->
    <exclude-pattern>vul/*</exclude-pattern>
    <exclude-pattern>pkxss/*</exclude-pattern>
    <exclude-pattern>assets/*</exclude-pattern>
    <exclude-pattern>docker/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>

    <!-- Enforce PSR-12 -->
    <rule ref="PSR12"/>
</ruleset>
